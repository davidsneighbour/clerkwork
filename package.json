{
  "name": "@davidsneighbour/clerkwork",
  "description": "Reusable AI skills for software engineering workflows: dependency maintenance, issue triage, project tracking, and repository upkeep.",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidsneighbour/clerkwork.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@dnbhq/biome-config": "0.2.3",
    "@dnbhq/markdownlint-config": "0.2.11",
    "@dnbhq/release-config": "1.1.3",
    "@dnbhq/tsconfig": "0.1.6",
    "@release-it/conventional-changelog": "12.0.0",
    "@types/node": "26.2.0",
    "cspell": "10.1.0",
    "release-it": "21.0.2",
    "typescript": "7.0.2"
  },
  "scripts": {
    "check": "biome check . && npm run typecheck && npm run validate:skills && npm run test && npm run lint:markdown && npm run lint:spelling",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:markdown": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc \"**/*.{md,mdx}\" \"#scratch/**\"",
    "lint:markdown:fix": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc --fix \"**/*.{md,mdx}\" \"#scratch/**\"",
    "lint:spelling": "cspell .",
    "release": "release-it --config .release-it.ts --ci",
    "release:dry": "release-it --config .release-it.ts --dry-run --ci",
    "release:force": "release-it --config .release-it.ts --ci --no-increment",
    "release:major": "release-it --config .release-it.ts --ci --increment=major",
    "release:minor": "release-it --config .release-it.ts --ci --increment=minor",
    "release:patch": "release-it --config .release-it.ts --ci --increment=patch",
    "synchwork": "meld ~/github.com/davidsneighbour/clerkwork ~/github.com/davidsneighbour/idiolect ~/github.com/davidsneighbour/posthaste ~/github.com/davidsneighbour/gazetteer ~/github.com/davidsneighbour/patternbook ~/github.com/davidsneighbour/gallimaufry",
    "test": "node --test \"skills/**/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "validate:skills": "node scripts/validate-skills.ts"
  },
  "cspell": {
    "version": "0.2",
    "language": "en-GB",
    "files": [
      "**/*"
    ],
    "ignorePaths": [
      "node_modules",
      "package-lock.json",
      "scratch"
    ],
    "dictionaryDefinitions": [
      {
        "name": "workspace-dictionary",
        "path": "./.vscode/dictionary.txt",
        "addWords": true
      }
    ],
    "dictionaries": [
      "workspace-dictionary"
    ]
  },
  "overrides": {
    "js-yaml": "5.2.2",
    "markdown-it": "14.3.0",
    "linkify-it": "5.0.2"
  },
  "type": "module"
}
